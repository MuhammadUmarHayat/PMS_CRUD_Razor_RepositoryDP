@page "{id:int}"
@model Books_Management_System.Pages.Products.DeleteModel
@{
    ViewData["Title"] = "Delete Product";
}

<h1>Delete Product</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this product?
</div>

<div class="card mb-3" style="max-width:500px">
    <div class="card-body">
        <h4>@Model.Product.Title</h4>

        <img src="@Url.Content("~/" + Model.Product.image)"
             alt="@Model.Product.Title"
             style="width:150px;height:150px;object-fit:cover"
             class="mb-3" />

        <p><strong>Price:</strong> @Model.Product.price</p>
        <p><strong>Quantity:</strong> @Model.Product.quantity</p>
    </div>
</div>

<form method="post">
    <button type="submit" class="btn btn-danger">
        Confirm Delete
    </button>

    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
