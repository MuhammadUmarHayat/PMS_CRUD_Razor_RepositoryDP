@page "{id:int}"
@model Books_Management_System.Pages.Products.DetailsModel


@{
    ViewData["Title"] = "Product Details";
}

<h1>Product Details</h1>

<div class="card" style="max-width:600px">
    <div class="card-body">
        <h4>@Model.Product.Title</h4>

        <img src="@Url.Content("~/" + Model.Product.image)"
             alt="@Model.Product.Title"
             style="width:200px;height:200px;object-fit:cover"
             class="mb-3" />

        <p><strong>ID:</strong> @Model.Product.Id</p>
        <p><strong>Description:</strong> @Model.Product.description</p>
        <p><strong>Price:</strong> @Model.Product.price</p>
        <p><strong>Quantity:</strong> @Model.Product.quantity</p>
        <p>
            <strong>Status:</strong>
            @(Model.Product.status == "A" ? "Active" : "Inactive")
        </p>

        <a asp-page="Edit" asp-route-id="@Model.Product.Id"
           class="btn btn-warning">Edit</a>

        <a asp-page="Index" class="btn btn-secondary">Back</a>
    </div>
</div>

